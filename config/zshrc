# 补全目录必须在 compinit 之前加入。
if [[ -d "$HOME/.local/share/zsh/zsh-completions/src" ]]; then
    fpath=("$HOME/.local/share/zsh/zsh-completions/src" $fpath)
fi
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select

# 已有历史记录配置时，优先保留原路径和策略。
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY HIST_IGNORE_DUPS
alias ll='ls -alh'

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#737aa2'
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

eval "$(starship init zsh)"

# 高亮配色先定义，插件最后加载。
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]='fg=#cdd6f4'
ZSH_HIGHLIGHT_STYLES[command]='fg=#94e2d5'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#94e2d5'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#f38ba8'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#a6e3a1'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#a6e3a1'
ZSH_HIGHLIGHT_STYLES[path]='fg=#89b4fa,underline'
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
